      <img src="{{ '/assets/img/gifs/flame.gif' | url }}" alt="Alecsander Vitor" style="border: 4px outset #ffffff; background: #000; padding: 6px; width: 120px;" />
      <div style="font-family: var(--font-pixel); font-size: 11px; color: #ffff00; margin-top: 8px;">ALECSANDER VITOR</div>
